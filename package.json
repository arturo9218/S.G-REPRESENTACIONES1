{
  "name": "ar-monitor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/patch-ngsw-notification-sound.cjs",
    "prestart": "node scripts/inject-vapid.cjs && node scripts/patch-ngsw-notification-sound.cjs",
    "start": "ng serve",
    "prebuild": "node scripts/inject-vapid.cjs && node scripts/patch-ngsw-notification-sound.cjs",
    "build": "ng build",
    "manual:pdf": "node scripts/generate-manual-pdf.cjs",
    "deploy:supabase-functions": "npx -y supabase@latest functions deploy ingest-reading --no-verify-jwt && npx -y supabase@latest functions deploy check-offline-push --no-verify-jwt && npx -y supabase@latest functions deploy ai-chart-insight",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engines": {
    "node": ">=18 <23"
  },
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@angular/service-worker": "^16.2.12",
    "@sentry/angular-ivy": "^7.120.0",
    "@supabase/supabase-js": "^2.100.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.0",
    "@types/jasmine": "~4.3.0",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3"
  }
}
